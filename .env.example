# Required: public URL of the license backend verification route.
# Example: https://your-license-api.onrender.com/api/verify-license
LICENSE_SERVER_URL=https://nova-main-backend.vercel.app/api/verify-license

# No browser install is required. Gmail automation runs in the Clearcote Chromium
# build that ships inside NovaMail — the installer contains the browser, so the app
# never downloads anything at runtime. For source builds, `npm run build` fetches the
# browser once on the build machine (see scripts/prepare-browser.cjs).

# --- Device emulation (optional) ------------------------------------------------
# The interactive Gmail browser presents a complete new machine identity on every launch so that
# accounts are not linked by a shared fingerprint. The devices come from the bundled catalog
# (76 real machines, 19 per OS); regenerate it with `node scripts/build-device-catalog.cjs`. By
# default it rotates across all four OS families (windows, macos, linux, android), so each launch
# behaves like a different machine. Set NOVAMAIL_DEVICE_POOL=host for the most conservative config
# (hardware only, no cross-OS tells). See docs/device-emulation.md. All values below are optional.
#
# NOVAMAIL_DEVICE_POOL=all           # all (default) | host | desktop | mobile | windows,macos,linux,android
# NOVAMAIL_DEVICE_EMULATION=1        # 0/false/off disables the persona layer entirely
# NOVAMAIL_DEVICE_SEED=              # pin one fixed identity, device + hand (defaults to a fresh seed per launch)
# NOVAMAIL_DEVICE_ID=                # pin one catalog entry by id (overrides the draw)
# NOVAMAIL_DEVICE_GPU_CLASS=         # filter the draw to a GPU vendor class: intel|amd|nvidia|apple|qualcomm|arm|mobile
# NOVAMAIL_STORAGE_QUOTA_MB=64000    # reported navigator.storage quota (realistic, not the 10 GiB incognito cap)
# NOVAMAIL_GEOIP=1                   # 0 disables the egress-IP geolocation layer
# NOVAMAIL_GEO_TIMEOUT_MS=8000       # budget for the egress-IP geolocation lookup (through the proxy)

# --- Proxy (optional) -----------------------------------------------------------
# Optional egress proxy. Credentials are sent on the engine's own auth flags, never in
# --proxy-server. When a list is given, each launch draws one deterministically from its seed.
#
# NOVAMAIL_PROXY=http://user:pass@host:8080
# NOVAMAIL_PROXIES=                  # list, one per line or comma-separated
# NOVAMAIL_PROXY_BYPASS=             # hosts that skip the proxy (--proxy-bypass-list)
